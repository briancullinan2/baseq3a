#include "ui/menudef.h"

{
    assetGlobalDef {
        font "fonts/font" 16                             // Main menu font
        smallFont "fonts/smallfont" 12                   // Small informational font
        bigFont "fonts/bigfont" 20                       // Accent titles
        cursor "ui/assets/3_cursor3"                     // Interactive cursor asset
        gradientBar "ui/assets/gradientbar2.tga"         
        itemFocusSound "sound/misc/menu2.wav"            
        
        fadeClamp 1.0                                    
        fadeCycle 1                                      
        fadeAmount 0.1                                   

        shadowColor 0.1 0.1 0.1 0.25                     
    }

    menuDef {
        name "main"
        fullScreen MENU_TRUE               
        rect 0 0 640 480               
        visible MENU_TRUE               
        focusColor 1 0 0 1                               // Solid red focus highlight to match original pulse

        onOpen { 
            setitemcolor fadebox backcolor 0 0 0 1 ; 
            fadeout fadebox ;
            uiScript stopRefresh ;
        }
        
        onESC { open quit_popmenu }

        // ==========================================
        // HEADER: LOGO BANNER & TEXT MODIFICATION
        // ==========================================

        // Center-aligned 3D Animated Banner object placement matching C refdef viewport
        itemDef {
            name q3_banner
            style WINDOW_STYLE_SHADER
            rect 0 0 640 120
            background "models/mapobjects/banner/banner5.md3"
            visible 1
            decoration
        }

        // Custom mod title "CHAMPAIGN" aligned exactly beneath the main logo graphic
        itemDef {
            name champagne_title
            text "CHAMPAIGN"
            style 0
            textstyle 6                                  // Drop shadow style overlay
            rect 0 115 640 30
            forecolor 1 0.6 0 1                          // Pure golden orange hue to blend with logo assets
            textscale .45
            textalign 1                                  // Center justify text
            textalignx 320
            textaligny 20
            visible 1
            decoration
        }

        // ==========================================
        // MAIN NAVIGATION BUTTONS (Vanilla Style)
        // ==========================================

        // --- SINGLE PLAYER ---
        itemDef {
            name singleplayer
            text "SINGLE PLAYER"
            type 1
            style 0 
            textstyle 6
            rect 0 134 640 30                             // Exact layout Y coordinates from the original code
            textalign 1
            textscale .416      
            textalignx 320
            textaligny 24
            forecolor 0.7 0 0 1                          // Default text dark red shade
            visible 1 
            action { play "sound/misc/kcaction.wav" ; close main ; open Skirmish }
        }

        // --- MULTIPLAYER ---
        itemDef {
            name multiplayer
            text "MULTIPLAYER"
            type 1
            style 0 
            textstyle 6
            rect 0 168 640 30                             // Dynamic spacing increments (+34 pixels per entry)
            textalign 1
            textscale .416      
            textalignx 320
            textaligny 24
            forecolor 0.7 0 0 1
            visible 1 
            action { play "sound/misc/kcaction.wav" ; close main ; open joinserver }
        }

        // --- SETUP ---
        itemDef {
            name setup
            text "SETUP"
            type 1
            style 0 
            textstyle 6
            rect 0 202 640 30 
            textalign 1
            textscale .416      
            textalignx 320
            textaligny 24
            forecolor 0.7 0 0 1
            visible 1 
            action { play "sound/misc/kcaction.wav" ; close main ; open setup_menu ; open control_menu }
        }

        // --- DEMOS ---
        itemDef {
            name demos
            text "DEMOS"
            type 1
            style 0 
            textstyle 6
            rect 0 236 640 30 
            textalign 1
            textscale .416      
            textalignx 320
            textaligny 24
            forecolor 0.7 0 0 1
            visible 1 
            action { play "sound/misc/kcaction.wav" ; close main ; open demo }
        }

        // --- CINEMATICS ---
        itemDef {
            name cinematics
            text "CINEMATICS"
            type 1
            style 0 
            textstyle 6
            rect 0 270 640 30 
            textalign 1
            textscale .416      
            textalignx 320
            textaligny 24
            forecolor 0.7 0 0 1
            visible 1 
            action { play "sound/misc/kcaction.wav" ; close main ; open cinematicMenu }
        }

        // --- MODS ---
        itemDef {
            name mods
            text "MODS"
            type 1
            style 0 
            textstyle 6
            rect 0 304 640 30 
            textalign 1
            textscale .416      
            textalignx 320
            textaligny 24
            forecolor 0.7 0 0 1
            visible 1 
            action { play "sound/misc/kcaction.wav" ; close main ; open mod }
        }

        // --- EXIT ---
        itemDef {
            name exit
            text "EXIT"
            type 1
            style 0 
            textstyle 6
            rect 0 338 640 30
            textalignx 320
            textaligny 24 
            textscale .416
            textalign 1     
            forecolor 0.7 0 0 1
            visible 1 
            action { play "sound/misc/kcaction.wav" ; open quit_popmenu }
        }

        // ==========================================
        // FOOTER AND MATURE RATING LABELS
        // ==========================================

        // Mature Target Audience warning banner
        itemDef {
            name warning_banner
            text "DEMO      FOR MATURE AUDIENCES      DEMO"
            style 0
            textscale .30
            rect 0 372 640 30
            textalign 1 
            textaligny 20
            textalignx 320 
            forecolor 0.5 0 0 1                          // Deep blood-red warning tint
            visible 1 
            decoration  
        }

        // Dynamic copyright declaration bottom row
        itemDef {
            name copyright
            text "Quake III Arena(c) 1999-2000, Id Software, Inc.  All Rights Reserved"
            style 0
            textscale .25
            rect 0 400 640 40
            textalign 1 
            textaligny 32
            textalignx 320 
            forecolor 0.5 0 0 1
            visible 1 
            decoration  
        }

        // UI Initialization Transition Mask
        itemDef {
            name fadebox                    
            style WINDOW_STYLE_FILLED
            background "ui/assets/fadebox.tga"
            forecolor 0 0 0 1
            backcolor 0 0 0 1
            rect 0 0 640 480
            visible 1 
            decoration
        }
    }
}